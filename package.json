{
  "name": "leader-line-plus",
  "version": "2.0.0",
  "description": "Draw a leader line in your web page. A maintained fork of anseki/leader-line: ES module, TypeScript, events, auto-positioning and native animations.",
  "keywords": [
    "arrow",
    "attention",
    "bubble",
    "esm",
    "highlight",
    "leader",
    "line",
    "markup",
    "spotlight",
    "svg",
    "typescript"
  ],
  "homepage": "https://github.com/minipps/leader-line#readme",
  "bugs": "https://github.com/minipps/leader-line/issues",
  "license": "MIT",
  "author": {
    "name": "anseki",
    "url": "https://github.com/anseki"
  },
  "contributors": [
    {
      "name": "minipps",
      "url": "https://github.com/minipps"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minipps/leader-line.git"
  },
  "files": [
    "leader-line.min.js",
    "leader-line.mjs",
    "types/leader-line.d.ts",
    "types/leader-line.d.mts"
  ],
  "type": "commonjs",
  "sideEffects": true,
  "main": "leader-line.min.js",
  "module": "leader-line.mjs",
  "types": "types/leader-line.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/leader-line.d.mts",
        "default": "./leader-line.mjs"
      },
      "require": {
        "types": "./types/leader-line.d.ts",
        "default": "./leader-line.min.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:serve": "node test/server.mjs",
    "build:defs": "node scripts/build-defs.mjs",
    "e18e": "npx -y @e18e/cli@^0.7.0 analyze",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run lint && npm run format:check && npm run build && npm run test:types && npm test",
    "prepublishOnly": "npm run build",
    "test:types": "tsc -p test/types && tsc -p src"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "jasmine-core": "^7.0.2",
    "oxc-minify": "^0.152.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "playwright-core": "^1.63.0",
    "test-page-loader": "^1.0.8",
    "typescript": "^6.0.3"
  },
  "title": "LeaderLine"
}
