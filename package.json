{
  "name": "@minipps/leader-line",
  "version": "1.1.0",
  "title": "LeaderLine",
  "description": "Draw a leader line in your web page. A maintained fork of anseki/leader-line with ES module and TypeScript support.",
  "type": "commonjs",
  "keywords": [
    "leader",
    "line",
    "markup",
    "arrow",
    "attention",
    "highlight",
    "spotlight",
    "bubble",
    "svg",
    "esm",
    "typescript"
  ],
  "main": "leader-line.min.js",
  "module": "leader-line.mjs",
  "types": "types/leader-line.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/leader-line.d.mts",
        "default": "./leader-line.mjs"
      },
      "require": {
        "types": "./types/leader-line.d.ts",
        "default": "./leader-line.min.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "leader-line.min.js",
    "leader-line.mjs",
    "types/leader-line.d.ts",
    "types/leader-line.d.mts"
  ],
  "sideEffects": true,
  "devDependencies": {
    "anim-event": "^1.0.16",
    "cheerio": "^1.0.0-rc.9",
    "clean-css": "^5.1.2",
    "grunt": "^1.4.1",
    "grunt-task-helper": "^0.3.10",
    "htmlclean": "^3.0.8",
    "jasmine-core": "^3.7.1",
    "log4js": "^6.4.0",
    "node-static-alias": "^1.1.2",
    "plain-draggable": "^2.5.12",
    "pre-proc": "^1.0.2",
    "test-page-loader": "^1.0.8",
    "uglify-js": "^3.13.7"
  },
  "scripts": {
    "build": "grunt build",
    "test": "node ./test/httpd",
    "prepublishOnly": "grunt build"
  },
  "homepage": "https://github.com/minipps/leader-line#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minipps/leader-line.git"
  },
  "bugs": "https://github.com/minipps/leader-line/issues",
  "license": "MIT",
  "author": {
    "name": "anseki",
    "url": "https://github.com/anseki"
  },
  "contributors": [
    {
      "name": "minipps",
      "url": "https://github.com/minipps"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
